PYTHON_IPC_PORT=8000
SERVER_URL=http://localhost:5000
ELECTRON_RECEIVER_PORT=8766

# APP_MODE configures the Whitelist Enforcer. 
# "exam" (strict, default) will kill unauthorized processes like terminals.
# "dev" (relaxed) allows tools like VS Code, cmd, powershell for local development.
# If unset, defaults safely to "exam".
APP_MODE=exam
