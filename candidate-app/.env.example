SERVER_URL=http://localhost:5000
# Local Python/receiver ports are assigned automatically; no port configuration needed.
# Optional interpreter override. Prefer a local .venv with dependencies installed.
# PYTHON_PATH=C:/path/to/your/venv/Scripts/python.exe

# APP_MODE configures the Whitelist Enforcer. 
# "exam" (strict, default) will kill unauthorized processes like terminals.
# "dev" (relaxed) allows tools like VS Code, cmd, powershell for local development.
# If unset, defaults safely to "exam".
APP_MODE=exam
ALLOW_DEV_BROWSERS=false
