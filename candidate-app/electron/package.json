{
  "name": "candidate-app-electron",
  "productName": "IntegrityFlow",
  "version": "1.0.0",
  "description": "IntegrityFlow Candidate Exam Application",
  "main": "main.js",
  "build": {
    "appId": "com.integrityflow.candidate",
    "productName": "IntegrityFlow",
    "win": {
      "icon": "assets/icon.ico"
    }
  },
  "scripts": {
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "build:renderer": "esbuild ../renderer/examScreen.js ../renderer/login.js ../renderer/identity.js --bundle --outdir=../renderer/dist"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "electron": "^29.0.0",
    "express": "^5.2.1",
    "form-data": "^4.0.6",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
