MONGODB_URI=mongodb://localhost:27017/integrityflow
SERVER_PORT=5000
DASHBOARD_URL=http://localhost:5173

# Core Authentication Secrets (generate unique, cryptographically random 32+ char secrets; never commit real secrets)
JWT_SECRET=your_jwt_access_token_secret_here_min_32_chars
RESET_TOKEN_SECRET=your_password_reset_token_secret_here_min_32_chars
EMAIL_TOKEN_SECRET=your_email_verification_token_secret_here_min_32_chars

# Modular Email Verification Feature Flag (Built & tested, disconnected placeholder)
# Note: This flag is not active in core auth yet until email verification is enabled.
REQUIRE_EMAIL_VERIFICATION=false
