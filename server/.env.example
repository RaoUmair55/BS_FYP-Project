MONGODB_URI=mongodb://localhost:27017/integrityflow
SERVER_PORT=5000
DASHBOARD_URL=http://localhost:5173

# Core Authentication Secrets (generate unique, cryptographically random 32+ char secrets; never commit real secrets)
JWT_SECRET=your_jwt_access_token_secret_here_min_32_chars
RESET_TOKEN_SECRET=your_password_reset_token_secret_here_min_32_chars
EMAIL_TOKEN_SECRET=your_email_verification_token_secret_here_min_32_chars

# Modular Email Verification Feature Flag (Email verification configuration)
# Set true to require verification for ALL accounts, including existing teachers and admins.
REQUIRE_EMAIL_VERIFICATION=false

# Required to create the initial administrator (set both to private values)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator

# Optional Cloudinary storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional real inbox delivery; without SMTP_HOST, Ethereal previews appear in server logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
